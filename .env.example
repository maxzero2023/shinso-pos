DATABASE_URL="postgresql://shinso:shinso@localhost:5432/shinso?schema=public"
SESSION_SECRET="change-me-shinso-session-secret-32chars"
QR_HMAC_SECRET="change-me-shinso-qr-hmac-secret-32chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments (AUT-29)
# PAYMENT_MODE=mock|sandbox|live  (default: mock — keeps FOH MVP mock pay path)
PAYMENT_MODE="mock"

# Stripe JP (card PaymentIntents, JPY). Use test keys for sandbox.
# Dashboard: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPay (optional). Without keys, sandbox uses labeled simulator.
# PAYPAY_API_KEY=""
# PAYPAY_API_SECRET=""
# PAYPAY_MERCHANT_ID=""
# PAYPAY_WEBHOOK_SECRET="paypay-sandbox-simulator-secret"

# WeChat / Alipay 访日客 (AUT-35). Without keys, sandbox uses labeled simulator (no real APIs).
# NEXT_PUBLIC_ENABLE_WECHAT_ALIPAY=true   # POS ボタン表示（default ON）
# WECHAT_MCH_ID=""
# WECHAT_API_KEY=""
# WECHAT_APP_ID=""
# WECHAT_WEBHOOK_SECRET="wechat-sandbox-simulator-secret"
# ALIPAY_APP_ID=""
# ALIPAY_PRIVATE_KEY=""
# ALIPAY_PUBLIC_KEY=""
# ALIPAY_WEBHOOK_SECRET="alipay-sandbox-simulator-secret"

# Hardware (AUT-30)
# HARDWARE_MODE=simulator|live  (default: simulator — no physical T1/printer required)
HARDWARE_MODE="simulator"

# LINE CRM (AUT-33)
# LINE_MODE=simulator|live  (default: simulator — no real LINE credentials required)
LINE_MODE="simulator"
# Optional live keys (unused in simulator; Messaging remains stub until wired)
# LINE_CHANNEL_ID=""
# LINE_CHANNEL_SECRET=""
# LINE_CHANNEL_ACCESS_TOKEN=""
