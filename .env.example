DATABASE_URL="postgresql://shinso:shinso@localhost:5432/shinso?schema=public"
SESSION_SECRET="change-me-shinso-session-secret-32chars"
QR_HMAC_SECRET="change-me-shinso-qr-hmac-secret-32chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments (AUT-29)
# PAYMENT_MODE=mock|sandbox|live  (default: mock — keeps FOH MVP mock pay path)
PAYMENT_MODE="mock"

# Stripe JP (card PaymentIntents, JPY). Use test keys for sandbox.
# Dashboard: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPay (optional). Without keys, sandbox uses labeled simulator.
# PAYPAY_API_KEY=""
# PAYPAY_API_SECRET=""
# PAYPAY_MERCHANT_ID=""
# PAYPAY_WEBHOOK_SECRET="paypay-sandbox-simulator-secret"
