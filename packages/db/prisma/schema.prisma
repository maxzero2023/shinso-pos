generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum BusinessDayStatus {
  open
  closed
}

enum ShiftStatus {
  open
  closed
}

enum CheckExceptionStatus {
  none
  flagged
  resolved
}

enum StaffRole {
  brand_admin
  owner
  manager
  floor
  kitchen
}

enum TableStatus {
  free
  seated
  ordering
  billing
}

enum CheckStatus {
  open
  paid
  void
}

enum CheckItemStatus {
  draft
  fired
  void
}

enum KitchenTicketStatus {
  queued
  preparing
  ready
  served
}

enum PaymentMethod {
  cash
  card
  paypay
  wechat
  alipay
}


model Brand {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]
  staff  Staff[]
}

model Store {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  timezone  String   @default("Asia/Tokyo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  areas         Area[]
  staff         Staff[]
  categories    MenuCategory[]
  reservations  Reservation[]
  waitlist      WaitlistTicket[]
  devices       Device[]
  printJobs     PrintJob[]
  businessDays  BusinessDay[]
  shifts        Shift[]
  checkAudits   CheckAuditLog[]
  members            Member[]
  couponTemplates    CouponTemplate[]
  couponIssues       CouponIssue[]
  pointAwards        PointAward[]
  ownerLineBinding   OwnerLineBinding?
  ownerLineDeliveryLogs OwnerLineDeliveryLog[]
  ingredients        Ingredient[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderAudits PurchaseOrderAudit[]
  expenseEntries     ExpenseEntry[]

  @@index([brandId])
}

model Area {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tables Table[]

  @@index([storeId])
}

model Table {
  id        String      @id @default(cuid())
  areaId    String
  code      String
  seats     Int         @default(4)
  status    TableStatus @default(free)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  area         Area             @relation(fields: [areaId], references: [id], onDelete: Cascade)
  checks       Check[]
  reservations Reservation[]
  waitlist     WaitlistTicket[]

  @@unique([areaId, code])
  @@index([areaId])
  @@index([status])
}

model Staff {
  id           String    @id @default(cuid())
  /// Home / assigned store. Null only for brand_admin (cross-store within brand).
  storeId      String?
  /// Brand scope for brand_admin (and optional denormalized brand for store staff).
  brandId      String?
  email        String    @unique
  name         String
  passwordHash String
  role         StaffRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store       Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand       Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  auditLogs   CheckAuditLog[]
  openedShifts Shift[]        @relation("ShiftOpenedBy")
  closedShifts Shift[]        @relation("ShiftClosedBy")
  stockLedgerEntries StockLedger[]
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchaseOrdersUpdated PurchaseOrder[] @relation("PurchaseOrderUpdatedBy")
  purchaseOrderAudits   PurchaseOrderAudit[]
  expenseEntries        ExpenseEntry[]

  @@index([storeId])
  @@index([brandId])
  @@index([role])
}

model MenuCategory {
  id        String   @id @default(cuid())
  storeId   String
  /// Japanese primary (legacy `name`)
  name      String
  nameZh    String?
  nameEn    String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([storeId])
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  /// Japanese primary (legacy `name`)
  name        String
  nameZh      String?
  nameEn      String?
  description String?
  priceYen    Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       MenuCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups MenuModifierGroup[]
  checkItems     CheckItem[]
  bomLines       BomLine[]

  @@index([categoryId])
  @@index([active])
}

model MenuModifierGroup {
  id          String   @id @default(cuid())
  menuItemId  String
  name        String
  minSelect   Int      @default(0)
  maxSelect   Int      @default(1)
  required    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem  MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifiers MenuModifier[]

  @@index([menuItemId])
}

model MenuModifier {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  priceYen  Int      @default(0)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group MenuModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Check {
  id         String      @id @default(cuid())
  tableId    String
  status     CheckStatus @default(open)
  guestCount Int         @default(1)
  note       String?
  openedAt   DateTime    @default(now())
  closedAt   DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  /// Asia/Tokyo business day / shift attribution (AUT-31)
  businessDayId String?
  shiftId       String?

  exceptionStatus            CheckExceptionStatus @default(none)
  exceptionNote              String?
  exceptionFlaggedAt         DateTime?
  exceptionFlaggedByStaffId  String?
  exceptionResolvedAt        DateTime?
  exceptionResolvedByStaffId String?
  exceptionResolveNote       String?

  table          Table            @relation(fields: [tableId], references: [id], onDelete: Restrict)
  businessDay    BusinessDay?     @relation(fields: [businessDayId], references: [id], onDelete: SetNull)
  shift          Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items          CheckItem[]
  kitchenTickets KitchenTicket[]
  payments       Payment[]
  printJobs      PrintJob[]
  auditLogs      CheckAuditLog[]
  /// Optional CRM member for points on paid settle (AUT-33)
  memberId       String?

  reservation    Reservation?
  waitlistTicket WaitlistTicket?
  member         Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([tableId])
  @@index([memberId])
  @@index([status])
  @@index([tableId, status])
  @@index([businessDayId])
  @@index([shiftId])
  @@index([exceptionStatus])
}

model CheckItem {
  id         String          @id @default(cuid())
  checkId    String
  menuItemId String
  name       String
  unitPriceYen Int
  qty        Int             @default(1)
  modifiers  Json            @default("[]")
  seat       Int?
  status     CheckItemStatus @default(draft)
  note       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  check      Check              @relation(fields: [checkId], references: [id], onDelete: Cascade)
  menuItem   MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  ticketLines KitchenTicketLine[]

  @@index([checkId])
  @@index([status])
}

model KitchenTicket {
  id        String              @id @default(cuid())
  checkId   String
  status    KitchenTicketStatus @default(queued)
  firedAt   DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  createdAt DateTime            @default(now())

  check     Check               @relation(fields: [checkId], references: [id], onDelete: Cascade)
  lines     KitchenTicketLine[]
  printJobs PrintJob[]

  @@index([checkId])
  @@index([status])
}

model KitchenTicketLine {
  id             String @id @default(cuid())
  kitchenTicketId String
  checkItemId    String
  qty            Int
  name           String
  modifiers      Json   @default("[]")

  kitchenTicket KitchenTicket @relation(fields: [kitchenTicketId], references: [id], onDelete: Cascade)
  checkItem     CheckItem     @relation(fields: [checkItemId], references: [id], onDelete: Cascade)

  @@index([kitchenTicketId])
  @@index([checkItemId])
}

enum PaymentStatus {
  pending
  succeeded
  failed
  canceled
}

enum PaymentProvider {
  mock
  stripe
  paypay
  wechat
  alipay
}

model Payment {
  id                String          @id @default(cuid())
  checkId           String
  method            PaymentMethod
  amountYen         Int
  mock              Boolean         @default(true)
  status            PaymentStatus   @default(succeeded)
  provider          PaymentProvider @default(mock)
  providerPaymentId String?
  clientSecret      String?
  idempotencyKey    String?         @unique
  failureReason     String?
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  check Check @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@index([providerPaymentId])
  @@index([status])
}

/// Idempotent webhook inbox (Stripe event.id / PayPay notificationId)
model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  paymentId   String?
  payload     Json?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([paymentId])
}

enum ReservationStatus {
  hold
  confirmed
  seated
  noshow
  cancelled
}

enum WaitlistStatus {
  waiting
  called
  seated
  cancelled
  expired
}

model Reservation {
  id          String            @id @default(cuid())
  storeId     String
  tableId     String?
  partySize   Int
  startAt     DateTime
  endAt       DateTime
  status      ReservationStatus @default(confirmed)
  guestName   String?
  guestPhone  String?
  guestLineId String?
  note        String?
  checkId     String?           @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  check Check? @relation(fields: [checkId], references: [id], onDelete: SetNull)

  @@index([storeId, startAt])
  @@index([tableId, status])
  @@index([status])
  @@index([storeId, status])
}

model WaitlistTicket {
  id          String         @id @default(cuid())
  storeId     String
  tableId     String?
  partySize   Int
  status      WaitlistStatus @default(waiting)
  ticketNo    Int
  guestName   String?
  guestPhone  String?
  guestLineId String?
  note        String?
  calledAt    DateTime?
  seatedAt    DateTime?
  expiresAt   DateTime?
  checkId     String?        @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  check Check? @relation(fields: [checkId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([storeId, ticketNo])
  @@index([tableId])
}

enum DeviceType {
  t1_pos
  kitchen_display
  printer
}

enum DeviceStatus {
  online
  offline
  out_of_paper
  error
}

enum PrintJobType {
  receipt
  kitchen
}

enum PrintJobStatus {
  queued
  printing
  printed
  failed
}

/// Store-scoped hardware (T1 / kitchen display / printer). AUT-30 / AUT-68.
model Device {
  id              String       @id @default(cuid())
  storeId         String
  type            DeviceType
  name            String
  code            String
  status          DeviceStatus @default(offline)
  lastHeartbeatAt DateTime?
  meta            Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  printJobs PrintJob[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([storeId, type])
  @@index([status])
}

/// Print queue for receipt / kitchen tickets. Consumes same Check / KitchenTicket (no shadow orders).
model PrintJob {
  id              String         @id @default(cuid())
  storeId         String
  deviceId        String?
  type            PrintJobType
  status          PrintJobStatus @default(queued)
  checkId         String?
  kitchenTicketId String?
  contentText     String
  contentHtml     String?
  errorMessage    String?
  printedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  check         Check?         @relation(fields: [checkId], references: [id], onDelete: SetNull)
  kitchenTicket KitchenTicket? @relation(fields: [kitchenTicketId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([deviceId])
  @@index([checkId])
  @@index([kitchenTicketId])
  @@index([createdAt])
}

/// Calendar business day in store timezone (Asia/Tokyo). AUT-31 / AUT-73.
model BusinessDay {
  id              String            @id @default(cuid())
  storeId         String
  /// Calendar date (no time) in Asia/Tokyo
  businessDate    DateTime          @db.Date
  status          BusinessDayStatus @default(open)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  openedByStaffId String?
  closedByStaffId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shifts Shift[]
  checks Check[]

  @@unique([storeId, businessDate])
  @@index([storeId, status])
}

/// Work shift under a BusinessDay. Close forbidden while open Checks exist.
model Shift {
  id              String      @id @default(cuid())
  storeId         String
  businessDayId   String
  status          ShiftStatus @default(open)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  openedByStaffId String?
  closedByStaffId String?
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  businessDay   BusinessDay @relation(fields: [businessDayId], references: [id], onDelete: Cascade)
  openedByStaff Staff?      @relation("ShiftOpenedBy", fields: [openedByStaffId], references: [id], onDelete: SetNull)
  closedByStaff Staff?      @relation("ShiftClosedBy", fields: [closedByStaffId], references: [id], onDelete: SetNull)
  checks        Check[]

  @@index([storeId, status])
  @@index([businessDayId])
}

/// Who / when / what on a Check (void, edit, exception). AUT-31 / AUT-72.
model CheckAuditLog {
  id        String   @id @default(cuid())
  storeId   String
  checkId   String
  staffId   String
  /// void_item | edit_item | flag_exception | resolve_exception
  action    String
  summary   String
  detail    Json?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  check Check @relation(fields: [checkId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@index([checkId, createdAt])
  @@index([staffId])
  @@index([action])
}

enum CouponIssueStatus {
  issued
  redeemed
}

/// LINE-bound member per store. AUT-33 / AUT-79.
model Member {
  id          String   @id @default(cuid())
  storeId     String
  lineUserId  String
  displayName String?
  points      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  coupons     CouponIssue[]
  pointAwards PointAward[]
  checks      Check[]

  @@unique([storeId, lineUserId])
  @@index([storeId])
}

model CouponTemplate {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  /// Flat discount in JPY when redeemed (MVP simple coupon).
  discountYen Int      @default(0)
  /// Points spent to issue (0 = campaign / free issue).
  pointsCost  Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store  Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  issues CouponIssue[]

  @@index([storeId, active])
}

model CouponIssue {
  id                String            @id @default(cuid())
  storeId           String
  templateId        String
  memberId          String
  code              String
  status            CouponIssueStatus @default(issued)
  issuedAt          DateTime          @default(now())
  redeemedAt        DateTime?
  redeemedByStaffId String?
  checkId           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  template CouponTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([memberId, status])
  @@index([storeId, status])
  @@index([checkId])
}

/// One points grant per paid Check (idempotent). AUT-33 / AUT-80.
model PointAward {
  id        String   @id @default(cuid())
  storeId   String
  memberId  String
  checkId   String   @unique
  points    Int
  amountYen Int
  createdAt DateTime @default(now())

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([storeId, memberId])
  @@index([memberId])
}

enum OwnerLineDigestKind {
  daily
  weekly
}

enum OwnerLineDeliveryStatus {
  sent
  failed
  skipped
}

/// Owner LINE digest binding (one per store). AUT-34 / AUT-82.
model OwnerLineBinding {
  id            String   @id @default(cuid())
  storeId       String   @unique
  lineUserId    String
  dailyEnabled  Boolean  @default(true)
  weeklyEnabled Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store        Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveryLogs OwnerLineDeliveryLog[]

  @@index([lineUserId])
}

/// Delivery / skip / failure log with metrics snapshot. AUT-34 / AUT-84.
model OwnerLineDeliveryLog {
  id           String                   @id @default(cuid())
  storeId      String
  bindingId    String?
  kind         OwnerLineDigestKind
  status       OwnerLineDeliveryStatus
  /// Asia/Tokyo YYYY-MM-DD (daily: same as periodTo)
  periodFrom   String
  periodTo     String
  messageText  String                   @default("")
  /// Snapshot of report metrics at send time (same口径 as AUT-32)
  snapshot     Json?
  errorMessage String?
  attemptCount Int                      @default(1)
  sentAt       DateTime?
  createdAt    DateTime                 @default(now())

  store   Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  binding OwnerLineBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([storeId, kind, createdAt])
  @@index([bindingId])
}

/// Raw material / ingredient per store. AUT-38.
model Ingredient {
  id                String   @id @default(cuid())
  storeId           String
  name              String
  /// Simple unit string for MVP: g / ml / pc (no conversion).
  unit              String
  lowStockThreshold Decimal  @db.Decimal(14, 3)
  /// Cost in JPY per unit (integer yen).
  costYenPerUnit    Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store   Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ledger  StockLedger[]
  bomLines BomLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([storeId, active])
}

/// Inventory movement. On-hand = sum(qtyDelta). Outbound that would go negative is rejected. AUT-38.
model StockLedger {
  id           String   @id @default(cuid())
  ingredientId String
  /// Positive = inbound, negative = outbound.
  qtyDelta     Decimal  @db.Decimal(14, 3)
  /// Free-text reason: inbound / outbound / adjustment / waste / …
  reason       String
  createdById  String?
  createdAt    DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  createdBy  Staff?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ingredientId, createdAt])
  @@index([createdById])
}

/// Recipe line: MenuItem consumes Ingredient qtyPerItem. AUT-38 / AUT-99.
model BomLine {
  id           String   @id @default(cuid())
  menuItemId   String
  ingredientId String
  qtyPerItem   Decimal  @db.Decimal(14, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
}

enum PurchaseOrderStatus {
  draft
  ordered
  received
  canceled
}

/// Minimal supplier master (store-scoped). AUT-39.
model Supplier {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders PurchaseOrder[]

  @@unique([storeId, name])
  @@index([storeId])
}

/// Purchase order: draft → ordered → received | canceled. AUT-39.
model PurchaseOrder {
  id           String              @id @default(cuid())
  storeId      String
  supplierId   String?
  status       PurchaseOrderStatus @default(draft)
  note         String?
  createdById  String?
  updatedById  String?
  orderedAt    DateTime?
  receivedAt   DateTime?
  canceledAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  store     Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier  Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy Staff?                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Staff?                @relation("PurchaseOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  lines     PurchaseOrderLine[]
  audits    PurchaseOrderAudit[]

  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id           String   @id @default(cuid())
  orderId      String
  ingredientId String
  /// Ordered qty (>= 0).
  orderedQty   Decimal  @db.Decimal(14, 3)
  /// Received qty (null until receive). May be short or over vs ordered.
  receivedQty  Decimal? @db.Decimal(14, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([orderId, ingredientId])
  @@index([orderId])
  @@index([ingredientId])
}

/// Audit trail for PO create / edit / receive / cancel. AUT-39.
model PurchaseOrderAudit {
  id        String   @id @default(cuid())
  storeId   String
  orderId   String
  staffId   String?
  /// create | update | order | receive | cancel
  action    String
  summary   String
  detail    Json?
  createdAt DateTime @default(now())

  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([orderId, createdAt])
  @@index([staffId])
  @@index([action])
}

/// Brief store-day expense for management analysis (not statutory books). AUT-40.
model ExpenseEntry {
  id          String   @id @default(cuid())
  storeId     String
  /// Asia/Tokyo calendar date (no time)
  date        DateTime @db.Date
  /// JPY integer; always subtracted in margin (never added to revenue)
  amountYen   Int
  /// Free-text category e.g. 光熱費 / 消耗品 / その他
  category    String
  /// Optional short label
  label       String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy Staff? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, date])
  @@index([storeId, createdAt])
  @@index([createdById])
}
